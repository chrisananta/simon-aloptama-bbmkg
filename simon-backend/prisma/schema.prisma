generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String?
  name         String
  role         Role     @default(TEKNISI_UPT)
  title        String
  nip          String?
  email        String?
  uptStation   String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model UptStation {
  id          String   @id @default(uuid())
  stationid   String   @unique
  name        String
  regionGroup String
  location    String
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  devices     Device[]

  @@map("upt_stations")
}

model Device {
  devicesId             String              @id
  site                  String
  category              String
  merk                  String?
  uptStation            String
  locationName          String
  latitude              Float
  longitude             Float
  picKalibrasi          String?             @default("Balai")
  conditionStatus       EquipmentStatus     @default(NORMAL)
  calibrationStatus     CalibrationStatus   @default(VALID)
  lastCalibrated        DateTime            @db.Date
  calibrationValidUntil DateTime            @db.Date
  timkalibrasi          String
  lastReportedDate      DateTime?           @db.Date
  downtimeDuration      String?
  issueDescription      String?
  slaScore              Float?
  olaScore              Float?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  stationId             String?
  calibrationRecords    CalibrationRecord[]
  station               UptStation?         @relation(fields: [stationId], references: [id])
  slaOlaLogs            SlaOlaLog[]
  monthlyScores         DeviceMonthlyScore[]

  @@index([uptStation])
  @@index([category])
  @@index([stationId])
  @@map("devices")
}

model SlaOlaLog {
  id         String   @id @default(uuid())
  deviceId   String?
  uptStation String
  category   String
  kondisiSla Boolean  @default(true)
  kondisiOla Float    @default(100)
  kendala    String?
  status     String   @default("NORMAL")
  actor      String   @default("Operator UPT")
  timestamp  DateTime @default(now())
  // Tanggal kondisi yang dilaporkan (bisa mundur hingga 10 hari dari hari
  // pengisian, untuk mengisi data harian yang terlewat). Beda dengan
  // `timestamp` yang selalu mencatat waktu SUBMIT sebenarnya (untuk audit).
  reportDate DateTime @db.Date
  // true jika reportDate bukan hari ini saat data disimpan (pengisian susulan).
  isLate     Boolean  @default(false)
  device     Device?  @relation(fields: [deviceId], references: [devicesId])

  @@index([timestamp])
  @@index([deviceId])
  @@index([uptStation])
  @@index([reportDate])
  @@map("sla_ola_logs")
}

model DeviceMonthlyScore {
  id        String   @id @default(uuid())
  deviceId  String
  month     String
  year      Int
  sla       Float
  ola       Float
  actor     String   @default("Admin INSKAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  device    Device   @relation(fields: [deviceId], references: [devicesId], onDelete: Cascade)

  @@unique([deviceId, month, year])
  @@map("device_monthly_scores")
}

model CalibrationRecord {
  id                    String            @id @default(uuid())
  deviceId              String
  deviceName            String
  uptStation            String
  category              String
  lastCalibrated        DateTime          @db.Date
  calibrationValidUntil DateTime          @db.Date
  calibrationAgency     String
  certificateNumber     String?
  calibrationStatus     CalibrationStatus @default(VALID)
  notes                 String?
  createdAt             DateTime          @default(now())
  device                Device            @relation(fields: [deviceId], references: [devicesId])

  @@index([deviceId])
  @@index([createdAt])
  @@map("calibration_records")
}

model Petugas {
  id        String   @id @default(uuid())
  name      String
  nip       String?
  jabatan   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("petugas")
}

model AuditLog {
  id         String    @id @default(uuid())
  timestamp  DateTime  @default(now())
  table      LogTable
  action     LogAction
  recordId   String
  recordName String
  actor      String    @default("System")
  details    String
  status     String    @default("SUCCESS")
  ipOrSource String?   @default("SIMON API")

  @@index([timestamp])
  @@index([table])
  @@index([actor])
  @@map("audit_logs")
}

enum Role {
  TEKNISI_UPT
  KAUPT_KABBMKG
  ADMIN_INSKAL
  SUPER_ADMIN
}

enum EquipmentStatus {
  NORMAL
  GANGGUAN
  MATI
}

enum CalibrationStatus {
  VALID
  SEGERA_DIKALIBRASI
  KADALUWARSA
}

enum LogAction {
  TAMBAH
  EDIT
  HAPUS
  SIMPAN_SLA_OLA
  SIMPAN_KALIBRASI
  SYNC_SERVER
  RESET_DATA
  EXPORT_DATA
  LOGIN
  LOGOUT
  REFRESH_TOKEN
}

enum LogTable {
  master_stasiun
  master_alat
  master_sla_ola
  master_akun
  master_petugas
  kalibrasi
  sistem
  pengaturan
  autentikasi
}
